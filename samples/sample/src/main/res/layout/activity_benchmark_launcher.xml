<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:id="@+id/benchmark_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Java Benchmark: Select Caching Strategy"
        android:textSize="20sp"
        android:gravity="center"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/button_volatile_fields"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Test VOLATILE_FIELDS Strategy"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/button_smart_cache"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Test SMART_CACHE Strategy" />

</LinearLayout>
